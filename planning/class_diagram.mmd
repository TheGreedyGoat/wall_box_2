        }

        note for CustomerBill "speichert Kundendaten etc. als Snapshot"
    }
    

    WallBoxLine --|> MainLine : can be
    WallBoxLine --|> MVLine : can be

    WallBoxTransactionBlock "1"*--"n" MVLine: mvs
    WallBoxLog *-- WallBoxTransactionBlock : made of
    WallBoxTransactionBlock "1"*--"0..1" MainLine : start
    WallBoxTransactionBlock "1"*--"0..1" MainLine : stop

    WallBoxTransactionBlock --> Transaction: converts to

    Transaction -- TagAssignment

    TagAssignment o-- Customer
    

    Unit --|> KiloWattHour
    Unit --|> Euro
    
    Customer "1"*.."0,n" CompanyData
    Customer "1"*.."0,n" PersonalData
    PriceAssignment "n" *-- "1" Customer

    note for Customer "erhält Tags & Rechnungen"

    note for TagAssignment "wem ist tag x zum Zeitpunkt y zugeordnet?"
    note for PriceAssignment "welchen Preis hat ein Kunde zu Zeitpunkt x?"

    CustomerBill "0,n"<--"1" Customer : pays
    CustomerBill "0,1"*--"1,n" TransactionBill : made up by


    PersonalData o-- Adress
    PersonalData o-- Contact

    Contact o-- Phone
    Contact o-- Email

    CompanyData o-- Adress
    CompanyData o-- Contact



