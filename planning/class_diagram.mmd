    namespace log {

        class WallBoxLog ::: done{
            String head;

            String get deviceID
            DateTime get generationDate

            int logID
            TransactionLog[] transactionLogs

            static fromSource() Future<WallBoxLog?>
        }

        class WallBoxTransactionBlock ::: done{
            String id;
            String deviceID
            
            String? get tagID;
            List~MVLine~ mvLines;

            MainLine? start
            MainLine? stop

            toTransaction() Transaction? TODO
        }

        class WallBoxLine ::: done {
         <<abstract>>
            DateTime timeStamp
            KiloWattHour powerLevelWh

            LineType get type

            tryParse(String source) WallBoxLine?
        }

        class MainLine ::: done {
            String tagID
            bool isStart

        }

        class MVLine ::: done 


        note for WallBoxLog  "Entspricht einer einzelnen eingelesenen Log-Datei"
        note for WallBoxTransactionBlock  "Log einer einzelnen Transaktion\nhasStart  bzw hasEnd"
    }
        
    
    class Transaction ::: inProgress{
        String id
        String tagID;
        String deviceID;
        DateTime start;
        DateTime end;

        Interval get interval

        KiloWattHours powerUsage;
        Percentace? discount;

        getTagAssignment() TagAssignment?
    }

    class TagAssignment ::: inProgress{
        String tagID
        String? tagName
        DateTime from
        DateTime? to
        int customerID
        int? userID

        getCustomer(String tagID, DateTime timestamp) Customer?
    }
    class PriceAssignment ::: inProgress{
        int customerID
        Euro unitPrice
        DateTime from
        DateTime? to
    }

    

    namespace Stammdaten{
        class MasterData::: done{
            <<abstract>>

            validate() String?
        }
    class Customer ::: done{
        int id
        CompanyData? company;
        PersonalData? personal

        
                Adress? adress
                Contact? contact

        getPriceAtTime (DateTime date) Euro
        getTransactions(DateTime from, DateTime to) Transaction[]
    }
        namespace HauptStammdaten{

