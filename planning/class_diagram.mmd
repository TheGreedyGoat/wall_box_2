            }

        }
        namespace StammdatenBausteine{    
            class Adress::: done{
                String? street
                String? number
                String? postcode
                String? city
                String? country
            }

            class Contact::: done{
                Phone? phone
                Phone? mobile

                Email email
            }

            class Phone ::: done{
